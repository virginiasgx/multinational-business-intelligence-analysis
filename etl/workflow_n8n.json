    {
      "parameters": {
        "jsCode": "return [\n  { json: { desde: '2010-01-01', hasta: '2014-12-31' } },\n  { json: { desde: '2015-01-01', hasta: '2019-12-31' } },\n  { json: { desde: '2020-01-01', hasta: '2021-12-31' } }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        64,
        -352
      ],
      "id": "e3be3439-c07b-42f8-a0d8-0c11125771ff",
      "name": "Prepare periods for years"
    },
    {
      "parameters": {
        "jsCode": "\n/****************************************\n  1. OBTENER LOS TIPOS DE CAMBIO\n****************************************/\n\nconst respuestas = $(\"CurrencyAPI\").all();\n\nconst tiposCambio = {};\n\nfor (const respuesta of respuestas) {\n\n  const datos = respuesta.json.data;\n\n  for (const dato of datos) {\n\n    const anio = String(dato.period);\n\n    const cambio = Number(dato.currencies.EUR.value);\n\n    tiposCambio[anio] = cambio;\n\n  }\n}\n\n\n/****************************************\n  2. OBTENER LOS REGISTROS DEL CSV\n****************************************/\n\nconst pagos = $(\"Extract from File\").all();\n\n\n/****************************************\n  3. COLUMNAS QUE CONTIENEN USD\n****************************************/\n\nconst columnasUSD = [\n  \"OperatingrevenueTurnover\",\n  \"OperatingrevenueTurnover_green\",\n  \"OperatingrevenueTurnover_mergers\",\n  \"TotalassetsthUSD\",\n  \"TotalassetsthUSD_green\",\n  \"TotalassetsthUSD_mergers\",\n  \"FixedassetsthUSD\",\n  \"FixedassetsthUSD_green\",\n  \"FixedassetsthUSD_mergers\"\n];\n\n\n/****************************************\n  4. CONVERTIR USD A EUR\n****************************************/\n\nreturn pagos.map(item => {\n\n  const anio = String(item.json.year).trim();\n\n  const cambio = tiposCambio[anio];\n\n  // Comprobar que existe el cambio\n  if (cambio === undefined) {\n\n    throw new Error(\n      `No existe tipo de cambio para el año ${anio}`\n    );\n\n  }\n\n  // Mantener todas las columnas originales\n  const resultado = {\n    ...item.json,\n    exchange_rate: cambio\n  };\n\n  // NUEVO: Crear clave única del registro\n  resultado.record_key = [\n    item.json.iso3_o,\n    item.json.iso3_d,\n    anio,\n    item.json.naics2\n  ].join(\"_\");\n\n  // Convertir las 9 columnas monetarias\n  for (const columna of columnasUSD) {\n\n    const valor = item.json[columna];\n\n    if (valor !== null && valor !== undefined && valor !== \"\") {\n\n      const importeUSD = Number(\n        String(valor).replace(\",\", \".\")\n      );\n\n      if (!Number.isFinite(importeUSD)) {\n        throw new Error(\n          `Importe inválido en ${columna}: ${valor}`\n        );\n      }\n\n      resultado[columna + \"_eur\"] = Number(\n        (importeUSD * cambio).toFixed(2)\n      );\n\n    } else {\n\n      resultado[columna + \"_eur\"] = null;\n\n    }\n\n  }\n\n  return {\n    json: resultado\n  };\n\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
